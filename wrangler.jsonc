{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swipedtc",
  "main": "worker.ts",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
